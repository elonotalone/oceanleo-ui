{
  "name": "@oceanleo/ui",
  "version": "0.218.0",
  "description": "OceanLeo 全家桶统一前端外壳 — 单一事实源（侧边栏/AI 模型市场/账户/设置/主题/SSO/网关）。所有 *.oceanleo.com 站（除 crm）共享此包。",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:themes": "node scripts/gen-theme-css.mjs",
    "build:css": "node scripts/gen-theme-css.mjs && tailwindcss -i ./src/theme/_ui-input.css -o ./src/theme/ui.css --minify",
    "architecture:check": "node --experimental-strip-types scripts/check-domain-boundaries.mjs",
    "api:snapshot": "node scripts/public-api-snapshot.mjs",
    "api:check": "node scripts/public-api-snapshot.mjs --check",
    "consumers:scan": "node scripts/scan-consumer-imports.mjs",
    "consumers:check": "node scripts/scan-consumer-imports.mjs --summary --check-exports",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/helpers/assert-dom-guard.mjs --experimental-strip-types --experimental-loader ./tests/ts-extension-loader.mjs --test --test-concurrency=2 --test-timeout=180000 tests/*.test.mjs",
    "test:visual": "bash tests/visual/docker/run.sh",
    "test:visual:update": "bash tests/visual/docker/run.sh --update-snapshots",
    "build": "npm run build:css && npm run typecheck"
  },
  "exports": {
    ".": "./src/index.ts",
    "./shell": "./src/shell/index.ts",
    "./shell/nav-source": "./src/shell/nav-source/index.ts",
    "./shell/nav-source/use-route-navigation": "./src/shell/nav-source/use-route-navigation.ts",
